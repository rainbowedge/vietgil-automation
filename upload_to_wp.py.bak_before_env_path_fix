def find_media_by_filename(filename, auth_headers):
    """파일명으로 미디어 라이브러리 검색. -scaled 접미사·확장자 변형도 매칭."""
    stem = Path(filename).stem
    r = requests.get(
        f"{WP_URL}/wp-json/wp/v2/media",
        params={"search": stem, "per_page": 20},
        headers=auth_headers,
    )
    if r.status_code != 200:
        return None
    for item in r.json():
        item_name = Path(item.get("source_url", "")).name
        item_stem = Path(item_name).stem
        # 정확히 일치
        if item_name == filename:
            return {"id": item["id"], "url": item["source_url"]}
        # WordPress -scaled 접미사 제거 후 stem 비교
        normalized = item_stem[:-7] if item_stem.endswith("-scaled") else item_stem
        if normalized == stem:
            return {"id": item["id"], "url": item["source_url"]}
    return None


def build_alt_filename_map(raw_content):
    """마크다운 원문에서 alt text → 파일명 매핑 추출.

    지원 형식:
    1. <!-- 📷 이미지: file.jpg | Alt: 설명 -->
    2. 이미지 가이드 테이블 행: | N | file.jpg | Alt text | ... |
    """
    mapping = {}

    # 형식 1: 인라인 이미지 주석
    for m in re.finditer(
        r'<!--[^>]*이미지:\s*([^\s|]+\.(?:jpg|jpeg|png|webp|gif))[^>]*Alt:\s*([^|>]+?)(?:\s*\||-->)',
        raw_content, re.IGNORECASE,
    ):
        mapping[m.group(2).strip()] = m.group(1).strip()

    # 형식 2: 이미지 가이드 테이블 (헤더 행 제외)
    for m in re.finditer(
        r'^\|[^|\n]+\|\s*([^\s|]+\.(?:jpg|jpeg|png|webp|gif))\s*\|\s*([^|\n]+?)\s*\|',
        raw_content, re.MULTILINE,
    ):
        filename, alt = m.group(1).strip(), m.group(2).strip()
        # 테이블 헤더("파일명", "Alt Text" 등) 제외
        if filename.lower() not in ("파일명", "file", "filename") and alt.lower() not in ("alt", "alt text"):
            mapping[alt] = filename

    return mapping


def build_filename_alt_map(raw_content):
    """이미지 가이드 테이블에서 파일명 → Alt Text 매핑 추출 (build_alt_filename_map의 역방향)."""
    return {v: k for k, v in build_alt_filename_map(raw_content).items()}


def find_featured_filename(raw_content):
    """대표(썸네일) 이미지 파일명을 찾는다.

    1순위: 이미지 가이드 표에서 번호/구분 칸에 "대표"가 적힌 행의 파일명
    2순위(표에 표시가 없을 때): 파일명에 hero 또는 thumbnail이 포함된 것
    """
    for m in re.finditer(
        r'^\|\s*([^|\n]+?)\s*\|\s*([^\s|]+\.(?:jpg|jpeg|png|webp|gif))\s*\|',
        raw_content, re.MULTILINE,
    ):
        label, filename = m.group(1).strip(), m.group(2).strip()
        if "대표" in label:
            return filename

    for fn in parse_image_prompts(raw_content):
        if any(keyword in fn.lower() for keyword in ("hero", "thumbnail")):
            return fn

    return ""


def strip_image_guide_blocks(raw_content):
    """발행용 본문에서 이미지 생성·업로드 작업자를 위한 안내 텍스트를 제거한다.

    1) 본문 중간에 삽입된 안내 박스 (배경색 있는 문단, "📁 파일명:" 포함)
    2) 문서 끝의 "이미지 가이드 / Gemini 프롬프트 / 업로드 체크리스트" 부록 전체

    이 정보들은 process_images()/resolve_images()가 원본 raw_content에서
    이미 읽어 쓴 뒤이므로, 발행 본문에서는 안전하게 제거해도 된다.
    """
    content = raw_content

    # 1) 배경색 있는 안내 문단 제거 (파일명: 라벨이 들어있는 것만 대상으로 한정)
    content = re.sub(
        r'<!--\s*wp:paragraph\s*\{[^}]*"backgroundColor"[^}]*\}\s*-->\s*'
        r'<p>(?:(?!</p>).)*?파일명:(?:(?!</p>).)*?</p>\s*'
        r'<!--\s*/wp:paragraph\s*-->\s*',
        '',
        content,
        flags=re.DOTALL,
    )

    # 2) 문서 끝 안내 부록 제거: '---' 다음에 이미지 가이드류 헤더가 나오는 지점부터 끝까지
    m = re.search(r'\n-{3,}\s*\n#{1,6}[^\n]*(?:이미지\s*가이드|Gemini|이미지\s*업로드)', content)
    if m:
        content = content[:m.start()]

    return content.strip() + "\n"


def parse_image_prompts(raw_content):
    """'Gemini 이미지 생성 프롬프트' 섹션에서 파일명 → 영문 프롬프트 매핑 추출.

    workflow 명령이 만드는 형식을 그대로 읽습니다:
        파일명: xxx.jpg
        (크기: ... 줄은 있어도 없어도 됨)

        프롬프트:
        [프롬프트 내용, 여러 줄 가능]
    다음 '---' 또는 다음 '###' 헤더 또는 문서 끝에서 프롬프트가 끝난 것으로 봅니다.
    """
    prompts = {}
    pattern = re.compile(
        r'파일명:\s*([^\s\n]+\.(?:jpg|jpeg|png|webp))\s*\n'
        r'(?:크기:[^\n]*\n)?'
        r'\s*\n?'
        r'프롬프트:\s*\n'
        r'(.*?)'
        r'(?=\n---|\n###|\Z)',
        re.DOTALL,
    )
    for m in pattern.finditer(raw_content):
        filename = m.group(1).strip()
        prompt = m.group(2).strip()
        if filename and prompt:
            prompts[filename] = prompt
    return prompts


def resolve_images(content_html, raw_content, auth_headers):
    """wp:image 블록의 src를 미디어 라이브러리 URL로 교체.

    반환: (updated_html, resolved_count, missing_list)
    """
    alt_to_filename = build_alt_filename_map(raw_content)
    resolved = 0
    missing = []

    def replace_block(m):
        nonlocal resolved
        block = m.group(0)

        img_m = re.search(r'<img([^>]*)>', block)
        if not img_m:
            return block

        attrs = img_m.group(1)
        src_val = (re.search(r'src="([^"]*)"', attrs) or re.search(r"src='([^']*)'", attrs))
        alt_val = (re.search(r'alt="([^"]*)"', attrs) or re.search(r"alt='([^']*)'", attrs))
        src_val = src_val.group(1) if src_val else ""
        alt_val = alt_val.group(1) if alt_val else ""

        # 파일명 결정: src에 직접 있거나, alt로 매핑
        if src_val and not src_val.startswith("http"):
            filename = src_val
        elif not src_val and alt_val in alt_to_filename:
            filename = alt_to_filename[alt_val]
        else:
            if not src_val:
                missing.append(alt_val or "(alt 없음)")
            return block

        media = find_media_by_filename(filename, auth_headers)
        if not media:
            missing.append(filename)
            return block

        resolved += 1
        mid, url = media["id"], media["url"]

        # 블록 주석에 id 추가
        new_block = re.sub(
            r'<!--\s*wp:image\s*-->',
            f'<!-- wp:image {{"id":{mid},"sizeSlug":"large","linkDestination":"none"}} -->',
            block,
        )
        # img 태그: src 교체 + class 추가
        new_attrs = re.sub(r'src="[^"]*"', f'src="{url}"', attrs)
        if f'wp-image-{mid}' not in new_attrs:
            if 'class="' in new_attrs:
                new_attrs = re.sub(r'class="([^"]*)"', rf'class="\1 wp-image-{mid}"', new_attrs)
            else:
                new_attrs += f' class="wp-image-{mid}"'
        new_block = new_block.replace(f'<img{img_m.group(1)}>', f'<img{new_attrs}>')
        return new_block

    updated = re.sub(
        r'<!--\s*wp:image[^>]*-->.*?<!--\s*/wp:image\s*-->',
        replace_block,
        content_html,
        flags=re.DOTALL,
    )
    return updated, resolved, missing


# ─────────────────────────────────────────
# 이미지 생성 (신규 — Gemini/나노바나나)
# ─────────────────────────────────────────
#
# 2026-09-09 수정: 실제 설치된 google-genai(2.22.0)에서 client.interactions가
# 없다는 에러(--gen-test 실행 결과)를 확인해서, client.models.generate_content +
# response_modalities=["IMAGE"] 방식으로 교체했습니다. GitHub의 python-genai
# README 예시 및 설치된 패키지의 실제 타입(GenerateContentConfig.response_modalities,
# Part.as_image() 등 존재 확인)과 대조해서 맞춘 버전입니다.

def _resize_cover(img, target_w, target_h):
    """비율 유지하며 target 크기를 꽉 채우도록 리사이즈 후 가운데 기준으로 자르기."""
    src_ratio = img.width / img.height
    tgt_ratio = target_w / target_h
    if src_ratio > tgt_ratio:
        new_h = target_h
        new_w = max(target_w, int(new_h * src_ratio))
    else:
        new_w = target_w
        new_h = max(target_h, int(new_w / src_ratio))
    from PIL import Image
    img = img.resize((new_w, new_h), Image.LANCZOS)
    left = (new_w - target_w) // 2
    top = (new_h - target_h) // 2
    return img.crop((left, top, left + target_w, top + target_h))


def generate_image_file(prompt, out_path, is_thumbnail=False):
    """Gemini(나노바나나)로 이미지 생성 → 리사이즈 → out_path에 JPG로 저장."""
    from google import genai
    from google.genai import types
    from PIL import Image

    if not GEMINI_API_KEY:
        raise RuntimeError("GEMINI_API_KEY가 설정되어 있지 않습니다 (~/.vietgil.env 확인)")

    client = genai.Client(api_key=GEMINI_API_KEY)
    response = client.models.generate_content(
        model=GEMINI_MODEL,
        contents=prompt,
        config=types.GenerateContentConfig(response_modalities=["IMAGE"]),
    )

    gemini_image = None
    for part in response.parts:
        if part.inline_data:
            gemini_image = part.as_image()
            break
    if gemini_image is None:
        raise RuntimeError("Gemini 응답에 이미지가 없습니다 (안전 필터에 걸렸거나 텍스트만 반환됨)")

    # part.as_image()는 PIL 이미지가 아니라 google.genai.types.Image(bytes 보관용) 객체를 반환하므로
    # 실제 PIL 이미지로 다시 열어줘야 resize/convert 등을 쓸 수 있음
    import io
    img = Image.open(io.BytesIO(gemini_image.image_bytes))
    img = img.convert("RGB")
    if is_thumbnail:
        img = _resize_cover(img, 1200, 675)
    elif img.width > 1200:
        ratio = 1200 / img.width
        img = img.resize((1200, int(img.height * ratio)), Image.LANCZOS)

    out_path = Path(out_path)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    img.save(out_path, "JPEG", quality=85)
    return out_path


def upload_media(filepath, alt_text, headers):
    """이미지 파일을 워드프레스 미디어 라이브러리에 업로드하고 Alt Text를 설정합니다."""
    filename = Path(filepath).name
    auth_only = {k: v for k, v in headers.items() if k != "Content-Type"}

    with open(filepath, "rb") as f:
        file_bytes = f.read()

    upload_headers = {
        **auth_only,
        "Content-Disposition": f'attachment; filename="{filename}"',
        "Content-Type": "image/jpeg",
    }
    r = requests.post(f"{WP_URL}/wp-json/wp/v2/media", headers=upload_headers, data=file_bytes)
    if r.status_code != 201:
        print(f"   ⚠️  업로드 실패: {filename} (HTTP {r.status_code}) {r.text[:200]}")
        return None

    media = r.json()
    media_id = media["id"]

    if alt_text:
        requests.post(
            f"{WP_URL}/wp-json/wp/v2/media/{media_id}",
            headers=headers,
            json={"alt_text": alt_text},
        )

    print(f"   ✅ 업로드 완료: {filename} (ID: {media_id})")
    return {"id": media_id, "url": media["source_url"]}


def set_media_alt(media_id, alt_text, headers):
    """기존 미디어 라이브러리 항목의 Alt Text만 설정/수정."""
    r = requests.post(
        f"{WP_URL}/wp-json/wp/v2/media/{media_id}",
        headers=headers,
        json={"alt_text": alt_text},
    )
    if r.status_code != 200:
        print(f"❌ Alt Text 설정 실패 (HTTP {r.status_code}) {r.text[:200]}")
        sys.exit(1)
    saved = r.json().get("alt_text", "")
    print(f"✅ Alt Text 설정 완료 (ID: {media_id}): {saved}")


def verify_rank_math_meta(post_id, expected, auth_headers):
    """저장 직후 실제로 랭크매스 메타(포커스 키워드/설명/제목)가 반영됐는지 재확인.

    워드프레스 REST API는 register_post_meta로 등록되지 않은 메타 키를
    'meta' 필드로 보내도 조용히 무시한다 — 요청은 200/201로 성공해도
    실제로는 저장되지 않을 수 있음. 그래서 업로드 성공과 별개로
    반드시 다시 읽어서 대조해야 한다.
    """
    r = requests.get(f"{WP_URL}/wp-json/wp/v2/posts/{post_id}", headers=auth_headers)
    if r.status_code != 200:
        return None
    saved = (r.json().get("meta") or {})
    mismatched = [
        key for key, val in expected.items()
        if val and saved.get(key, "") != val
    ]
    return mismatched


def process_images(raw_content, auth_headers, headers, work_dir=".generated_images"):
    """원고에 필요한 이미지 중 미디어 라이브러리에 없는 것만 생성 → 리사이즈 → 업로드."""
    if not GEMINI_API_KEY:
        print("   ⚠️  GEMINI_API_KEY가 없어 이미지 자동 생성을 건너뜁니다 (기존처럼 수동 업로드 필요).")
        return

    prompts = parse_image_prompts(raw_content)
    if not prompts:
        return

    alts = build_filename_alt_map(raw_content)
    featured_filename = find_featured_filename(raw_content)
    print(f"\n🎨 이미지 자동 생성 확인 ({len(prompts)}개 후보)")

    for filename, prompt in prompts.items():
        if find_media_by_filename(filename, auth_headers):
            print(f"   ⏭️  이미 존재: {filename}")
            continue
        try:
            local_path = Path(work_dir) / filename
            is_thumb = filename == featured_filename or any(
                keyword in filename.lower() for keyword in ("hero", "thumbnail")
            )
            generate_image_file(prompt, local_path, is_thumbnail=is_thumb)
            upload_media(local_path, alts.get(filename, ""), headers)
        except Exception as e:
            print(f"   ⚠️  {filename} 생성/업로드 실패: {e}")


