# 메인 업로드
# ─────────────────────────────────────────

def upload_post(filepath):
    path = Path(filepath)
    if not path.exists():
        print(f"❌ 파일을 찾을 수 없습니다: {filepath}")
        sys.exit(1)

    check_credentials()
    headers = get_headers()
    auth_headers = {k: v for k, v in headers.items() if k != "Content-Type"}

    # ── 파일 파싱 ──
    post = frontmatter.load(str(path))
    title = post.get("title", path.stem)
    print(f"\n📄 {title}")
    print(f"   파일: {path.name}")

    raw_content = post.content

    # ── 이미지 자동 생성/업로드 (신규) ──
    process_images(raw_content, auth_headers, headers)

    # ── 발행 본문에서 이미지 안내 텍스트 제거 (신규) ──
    # process_images/resolve_images는 원본 raw_content를 그대로 써야 하므로
    # 안내 텍스트 제거는 별도 변수(publish_content)에만 적용한다.
    publish_content = strip_image_guide_blocks(raw_content)

    # ── 마크다운 → HTML ──
    md = markdown.Markdown(extensions=["extra", "nl2br", "sane_lists"])
    content_html = md.convert(publish_content)

    # ── 카테고리 ──
    category_ids = []
    for name in post.get("categories", []):
        cid = get_or_create_taxonomy(name, "categories", headers)
        if cid:
            category_ids.append(cid)
    if category_ids:
        print(f"   📁 카테고리 {len(category_ids)}개")

    # ── 태그 ──
    tag_ids = []
    for name in post.get("tags", []):
        tid = get_or_create_taxonomy(name, "tags", headers)
        if tid:
            tag_ids.append(tid)
    if tag_ids:
        print(f"   🏷️  태그 {len(tag_ids)}개")

    # ── 이미지 처리 (본문 삽입) ──
    content_html, img_resolved, img_missing = resolve_images(content_html, raw_content, auth_headers)
    if img_resolved:
        print(f"   🖼️  이미지 연결: {img_resolved}개")
    if img_missing:
        print(f"   ⚠️  미디어 라이브러리에 없는 이미지 {len(img_missing)}개: {', '.join(img_missing)}")

    # ── 대표 이미지(featured) 검색 ──
    featured_media_id = None
    featured_filename = post.get("featured_image_filename", "")
    if not featured_filename:
        # frontmatter에 명시 안 돼 있으면 이미지 가이드 표의 "대표" 표시나
        # 파일명 관례(hero/thumbnail)로 추정
        featured_filename = find_featured_filename(raw_content)
    if featured_filename:
        media = find_media_by_filename(featured_filename, auth_headers)
        if media:
            featured_media_id = media["id"]
            print(f"   🖼️  대표 이미지 연결: {featured_filename} (ID: {featured_media_id})")
        else:
            print(f"   ⚠️  대표 이미지 없음: {featured_filename}")

    slug = post.get("slug", path.stem)

    # ── 슬러그로 기존 포스트 검색 ──
    r = requests.get(
        f"{WP_URL}/wp-json/wp/v2/posts",
        params={"slug": slug, "status": "any", "per_page": 1},
        headers=auth_headers,
    )
    existing = r.json() if r.status_code == 200 else []
    existing_id = existing[0]["id"] if existing else None
    existing_status = existing[0]["status"] if existing else None

    # ── 페이로드 ──
    payload = {
        "title": title,
        "slug": slug,
        "content": content_html,
        "excerpt": post.get("excerpt", ""),
        "status": "draft",
        "categories": category_ids,
        "tags": tag_ids,
        "meta": {
            "rank_math_focus_keyword": post.get("focus_keyword", ""),
            "rank_math_description": post.get("meta_description", ""),
            "rank_math_title": post.get("meta_title", ""),
        },
    }
    if featured_media_id:
        payload["featured_media"] = featured_media_id

    # ── 업로드 (신규 or 업데이트) ──
    STATUS_KO = {"publish": "발행됨", "draft": "초안", "pending": "검토 대기", "private": "비공개"}

    if existing_id:
        prev = STATUS_KO.get(existing_status, existing_status)
        if existing_status == "publish":
            print(f"\n🔄 기존 글 발견 (ID: {existing_id}, 현재: {prev}) — 초안으로 변경 후 업데이트 중...")
        else:
            print(f"\n🔄 기존 글 발견 (ID: {existing_id}, 현재: {prev}) — 업데이트 중...")
        r = requests.put(
            f"{WP_URL}/wp-json/wp/v2/posts/{existing_id}",
            json=payload,
            headers=headers,
        )
        success_code = 200
        action_label = "기존 글 업데이트"
    else:
        print("\n🚀 신규 글 업로드 중...")
        r = requests.post(f"{WP_URL}/wp-json/wp/v2/posts", json=payload, headers=headers)
        success_code = 201
        action_label = "신규 생성"

    if r.status_code == success_code:
        data = r.json()
        post_id = data["id"]
        print(f"\n✅ {action_label} 완료!")
        if existing_status == "publish":
            print(f"   상태: 발행됨 → 초안 (draft) ⚠️  재발행 전 반드시 확인")
        else:
            print(f"   상태: 초안 (draft)")
        print(f"   슬러그: /{data['slug']}/")
        print(f"\n🔗 지금 편집하기:")
        print(f"   {WP_URL}/wp-admin/post.php?post={post_id}&action=edit")

        # ── 랭크매스 메타 실제 저장 여부 재확인 (신규) ──
        mismatched = verify_rank_math_meta(post_id, payload["meta"], auth_headers)
        if mismatched:
            print(f"\n   ⚠️  랭크매스 메타가 실제로 저장되지 않았습니다: {', '.join(mismatched)}")
            print("   → 워드프레스가 이 메타 키들을 REST API에 등록하지 않아서 조용히 무시된 것으로 보입니다.")
            print("   → WPCode(또는 functions.php)에 register_post_meta 스니펫을 추가해야 앞으로 자동 저장됩니다.")
        elif payload["meta"].get("rank_math_focus_keyword") or payload["meta"].get("rank_math_description"):
            print(f"\n   ✅ 랭크매스 포커스 키워드·메타 디스크립션 저장 확인됨")

        print(f"\n📋 발행 전 체크리스트:")
        if img_missing:
            print(f"   □ 남은 이미지 확인/업로드: {', '.join(img_missing)}")
        else:
            print(f"   ☑ 이미지 생성·업로드·삽입 (자동 완료)")
        print(f"   □ Rank Math SEO 점수 확인 (80점 이상)")
        print(f"   □ 미리보기로 모바일 확인")
        print(f"   □ 발행")
    else:
        print(f"\n❌ {action_label} 실패 (HTTP {r.status_code})")
        try:
            err = r.json()
            print(f"   오류: {err.get('message', str(err))}")
            if "meta" in str(err):
                print("\n   💡 Rank Math 메타 필드 오류인 경우:")
                print("   워드프레스가 rank_math_* 메타 키를 REST API에 등록하지 않아서일 수 있습니다.")
                print("   WPCode에 register_post_meta 스니펫 추가 필요 (자세한 안내는 대화 참고).")
        except Exception:
            print(f"   응답: {r.text[:300]}")
        sys.exit(1)


