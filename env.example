# Vietgil WordPress 인증 정보
# 이 파일을 복사해서 .env 로 저장하고 실제 값을 입력하세요
# .env 파일은 절대 Git에 커밋하지 마세요

# WordPress 사이트 URL (슬래시 없이)
WP_URL=https://vietgil.com

# WordPress 사용자명 (관리자 계정)
WP_USER=your_username

# Application Password
# 발급 방법: WordPress 관리자 → 사용자 → 프로필 → 애플리케이션 비밀번호
# 이름에 "Claude Code" 입력 후 생성 → 공백 포함 그대로 붙여넣기
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Google 서비스 계정 인증 파일 경로
GOOGLE_CREDENTIALS_PATH=/path/to/google_credentials.json

# Google Sheets ID (URL의 /d/XXXXXXX/ 부분)
SHEETS_ID=your_sheets_id

# Google Search Console 사이트 URL (끝에 슬래시 포함)
GSC_SITE_URL=https://vietgil.com/

# ── 신규 추가 ──────────────────────────────
# Gemini API 키 (이미지 자동 생성용)
# 발급: https://aistudio.google.com/apikey 에서 발급
# (주의: 위 GOOGLE_CREDENTIALS_PATH의 서비스 계정 파일과는 다른, 별도의 API 키입니다)
GEMINI_API_KEY=your_gemini_api_key

# 이미지 생성 모델 (기본값 사용 권장, 필요시에만 변경)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
